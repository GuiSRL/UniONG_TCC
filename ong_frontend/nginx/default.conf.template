# nginx do frontend: serve o React e encaminha API, prévias e admin do Django ao backend.
# Modelo processado pela imagem oficial do nginx na subida (envsubst):
#   ${PORT}         porta em que o nginx escuta (Railway define; padrão 80)
#   ${BACKEND_URL}  endereço do Django, sem barra final (docker-compose: http://backend:8000;
#                   Railway: http://<servico>.railway.internal:8000)
# O endereço é resolvido a cada requisição (resolver + variável), para o nginx subir mesmo que a
# rede interna ainda não esteja pronta e acompanhar mudanças de IP do backend.

server {
    listen ${PORT};
    server_name _;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
    set $backend ${BACKEND_URL};

    # Anexos e imagens têm até 5 MB cada; despesas aceitam vários anexos por envio.
    client_max_body_size 25m;
    server_tokens off;

    # Cabeçalhos de segurança: o nginx não herda add_header do server num location que define o seu,
    # por isso eles se repetem em /assets/ e em /.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location /c/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /admin-django/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Arquivos do collectstatic (admin do Django e DRF), compartilhados por volume no docker-compose.
    # Sem o volume (ex.: Railway), só o admin do Django fica sem estilo; o sistema não usa /static/.
    location /static/ {
        alias /var/www/static/;
        expires 7d;
        access_log off;
    }

    # Arquivos do build do Vite têm hash no nome: cache longo.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        access_log off;
    }

    # Rotas do React (/admin, /transparencia, ...) caem no index.html.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
    }
}
